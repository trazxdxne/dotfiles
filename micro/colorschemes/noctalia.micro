color-link default "#e1e7f5,#0a1126"
color-link comment "#465ea4"

color-link identifier "#99b6f2"
color-link identifier.class "#99b6f2"
color-link identifier.var "#99b6f2"

color-link constant "#4e6ba6"
color-link constant.number "#4e6ba6"
color-link constant.string "#5581d9"

color-link symbol "#99b6f2"
color-link symbol.brackets "#e1e7f5"
color-link symbol.tag "#99b6f2"

color-link type "#99b6f2"
color-link type.keyword "#4e6ba6"

color-link special "#99b6f2"
color-link statement "#5581d9"
color-link preproc "#99b6f2"

color-link underlined "#99b6f2"
color-link error "bold #d98886"
color-link todo "bold #4e6ba6"

color-link diff-added "#5581d9"
color-link diff-modified "#4e6ba6"
color-link diff-deleted "#d98886"

color-link gutter-error "#d98886"
color-link gutter-warning "#4e6ba6"

color-link statusline "#e1e7f5,#0f1b40"
color-link tabbar "#e1e7f5,#0f1b40"
color-link indent-char "#0f1b40"
color-link line-number "#465ea4"
color-link current-line-number "#99b6f2"

color-link cursor-line "underlined"
color-link selection ",#0f1b40"
color-link color-column "#0f1b40"
color-link type.extended "default"
