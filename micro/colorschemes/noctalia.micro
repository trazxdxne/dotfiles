color-link default "#cdc5bd,#1a1b1c"
color-link comment "#656668"

color-link identifier "#db6d6d"
color-link identifier.class "#db6d6d"
color-link identifier.var "#db6d6d"

color-link constant "#8faeb1"
color-link constant.number "#8faeb1"
color-link constant.string "#d1b394"

color-link symbol "#db6d6d"
color-link symbol.brackets "#cdc5bd"
color-link symbol.tag "#db6d6d"

color-link type "#db6d6d"
color-link type.keyword "#8faeb1"

color-link special "#db6d6d"
color-link statement "#d1b394"
color-link preproc "#db6d6d"

color-link underlined "#db6d6d"
color-link error "bold #db6d6d"
color-link todo "bold #8faeb1"

color-link diff-added "#d1b394"
color-link diff-modified "#8faeb1"
color-link diff-deleted "#db6d6d"

color-link gutter-error "#db6d6d"
color-link gutter-warning "#8faeb1"

color-link statusline "#cdc5bd,#252627"
color-link tabbar "#cdc5bd,#252627"
color-link indent-char "#252627"
color-link line-number "#656668"
color-link current-line-number "#db6d6d"

color-link cursor-line "underlined"
color-link selection ",#252627"
color-link color-column "#252627"
color-link type.extended "default"
