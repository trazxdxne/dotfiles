autostart {
    workspace "1" {
        column {
            width {
                proportion 0.67
            }
            window app-id="brave-pommaclcbfghclhalboakcipcmmndhcj-Default" {
                command "/opt/brave-origin-bin/brave-origin" "--profile-directory=Default" "--app-id=pommaclcbfghclhalboakcipcmmndhcj"
                height { proportion 1.0; }
            }
            window app-id="com.ayugram.desktop" {
                command "AyuGram" "-autostart"
                height { proportion 1.0; }
            }
            window app-id="discord" {
                command "sh" "-c" "$HOME/Projects/discord-linux-bypass/discord_run.sh"
                height { proportion 1.0; }
            }
        }
        
        column {
            width {
                proportion 1.0
            }
            window app-id="brave-origin" {
                command "/opt/brave-origin-bin/brave-origin" "--new-window"
                height { proportion 1.0; }
            }
        }
    }
}
