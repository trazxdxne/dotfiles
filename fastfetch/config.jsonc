{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1
    },
    "type": "auto",
    "source": "CachyOS"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "│  Install",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -f %B / 2>/dev/null || echo 0); case $birth_install in ''|0|-1) echo unknown;; *) current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days;; esac"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ 󰉼 Theme",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "│ 󰀻 Icons",
      "keyColor": "blue"
    },
    {
      "type": "cursor",
      "key": "│  Cursor",
      "keyColor": "blue"
    },
    {
      "type": "terminalfont",
      "key": "│  Font",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ 󰻑 GPU",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display",
      "keyColor": "green",
      "compactType": "original-with-refresh-rate"
    },
        {
      "type": "disk",
      "folders": "/",
      "key": "│ 󱛟 Apacer AS2280P4 256GB (/)",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "folders": "/mnt/HDD_Linux",
      "key": "│ 󱛟 WDC WD10EZEX-22M (/mnt/HDD_Linux)",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ 󰾆 Memory",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime",
      "keyColor": "green"
    },
    "break"
  ]
}
