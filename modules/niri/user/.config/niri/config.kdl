workspace "1"
workspace "2"
workspace "1 " {
    open-on-output "HDMI-A-1"
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle,lv3:ralt_switch,misc:typo"
        }
        numlock
    }

    mouse {
        accel-speed 0
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "DP-1" {
    mode "1920x1080@200"
    scale 1
    transform "normal"
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "2400x1080"
    scale 1
    position x=0 y=1080
}

layout {
    gaps 12
    tab-indicator {
        width 10
        gap 2
        gaps-between-tabs 4
        corner-radius 0
    }

    center-focused-column "never"

    preset-column-widths {
        proportion 0.5
        proportion 0.67
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#f5c2e7"
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#f5c2e7"
        inactive-color "#45475a"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 0
        // right 0
        // top 0
        // bottom 0
    }
    background-color "transparent" 
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
//screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
	slowdown 0.5
}

overview {
    workspace-shadow {
        off
    }
}
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
    open-maximized true
    open-focused true
    background-effect {
       blur true
    }
}

window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    background-effect {
       blur true
    }
}

window-rule {
    match app-id="^brave-pommaclcbfghclhalboakcipcmmndhcj-Default$"
    match app-id="^com\\.ayugram\\.desktop$"
    match app-id="^discord$"
    open-on-workspace "1"
    default-column-display "tabbed"
}

window-rule {
    match app-id="^brave-chddojmiiokipokdfcabeikjhljgcafd-Default$"
    match app-id="^brave-agimnkijcaahngcdmfeangaknmldooml-Default$"
    open-on-workspace "1 "
    default-column-display "tabbed"
}

window-rule {
     match title="Picture in picture"
     open-floating true
}

window-rule {
    match app-id=r#"^brave-origin$"#
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id=r#"^steam$"#
    open-on-workspace "2"
    open-maximized true
    open-focused true
}

window-rule {
    match app-id=r#"^steam$"# title="Friends List"
    open-on-workspace "2"
    open-maximized false
    default-column-width { proportion 0.33; }
    open-focused true
}

window-rule {
    match app-id=r#"^Solo Leveling:ARISE OVERDRIVE$"#
    open-on-workspace "2"
    open-fullscreen true
}

window-rule {
    match app-id=r#"^org\.vinegarhq\.Sober$"#
    exclude title="^Servers$"
    open-on-workspace "2"
    open-maximized-to-edges true
}

window-rule {
    match app-id=r#"^org\.vinegarhq\.Sober$"# title="^Servers$"
    open-floating true
}

window-rule {
     match app-id=r#"^steam_app_381210$"#
     open-on-workspace "2"
     open-fullscreen true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match title="(?i)Blacklist"
    open-maximized true
}
window-rule {
	match app-id=r#"(?i)prismlauncher"#
	match app-id=r#"(?i)minecraft"#
	open-on-workspace "2"
	open-maximized true
}
window-rule {
	match app-id=r#"(?i)prismlauncher"# title=r#"(?i)^Console window"#
	open-on-workspace "2"
	open-maximized false
	open-floating true
	default-column-width { proportion 0.5; }
}
window-rule {
	match app-id=r#"^org\.gnome\.Nautilus$"#
	open-focused true
	background-effect {
	   blur true
	}
}
window-rule {
	match app-id=r#"obsidian"#
	open-focused true
	background-effect {
	   blur true
	}
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal" { spawn "uwsm" "app" "--" "wezterm" "start" "--always-new-process"; }
    Mod+Space hotkey-overlay-title="Run an Application Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+L hotkey-overlay-title="Lock the Screen" { spawn "noctalia" "msg" "session lock"; }
    Mod+E hotkey-overlay-title="Open a File Manager" { spawn "uwsm" "app" "--" "nautilus"; }

    //Mod+Alt+X          allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    Mod+Alt+Z            allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    Mod+MouseMiddle      allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    Mod+Alt+Space        allow-when-locked=true { spawn-sh "playerctl stop"; }
    Mod+Alt+Minus        allow-when-locked=true { spawn-sh "playerctl previous"; }
    Mod+Alt+Equal        allow-when-locked=true { spawn-sh "playerctl next"; }

    Mod+Tab repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    //Mod+H                     { focus-column-left; }
    //Mod+Alt+WheelScrollDown   { focus-window-down; }
    //Mod+Alt+WheelScrollUp     { focus-window-up; }
    //Mod+L                     { focus-column-right; }

    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Down  { move-window-down; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+H     { move-column-left; }
    Mod+Alt+J     { move-window-down; }
    Mod+Alt+K     { move-window-up; }
    Mod+Alt+L     { move-column-right; }

    Mod+Home     { focus-column-first; }
    Mod+End      { focus-column-last; }
    Mod+Alt+Home { move-column-to-first; }
    Mod+Alt+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Alt+Left  { move-column-to-monitor-left; }
    Mod+Shift+Alt+Down  { move-column-to-monitor-down; }
    Mod+Shift+Alt+Up    { move-column-to-monitor-up; }
    Mod+Shift+Alt+Right { move-column-to-monitor-right; }
    Mod+Shift+Alt+H     { move-column-to-monitor-left; }
    Mod+Shift+Alt+J     { move-column-to-monitor-down; }
    Mod+Shift+Alt+K     { move-column-to-monitor-up; }
    Mod+Shift+Alt+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Alt+Page_Down  { move-column-to-workspace-down; }
    Mod+Alt+Page_Up    { move-column-to-workspace-up; }
    Mod+Alt+U          { move-column-to-workspace-down; }
    Mod+Alt+I          { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Alt+WheelScrollDown   cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Alt+WheelScrollUp     cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Alt+WheelScrollRight  { move-column-right; }
    Mod+Alt+WheelScrollLeft   { move-column-left; }

    Mod+Shift+WheelScrollDown       cooldown-ms=25 { focus-column-right; }
    Mod+Shift+WheelScrollUp         cooldown-ms=25 { focus-column-left; }
    Mod+Alt+Shift+WheelScrollDown   cooldown-ms=25 { move-column-right; }
    Mod+Alt+Shift+WheelScrollUp     cooldown-ms=25 { move-column-left; }

    Mod+1     { focus-workspace 1; }
    Mod+2     { focus-workspace 2; }
    Mod+3     { focus-workspace 3; }
    Mod+4     { focus-workspace 4; }
    Mod+5     { focus-workspace 5; }
    Mod+6     { focus-workspace 6; }
    Mod+7     { focus-workspace 7; }
    Mod+8     { focus-workspace 8; }
    Mod+9     { focus-workspace 9; }
    Mod+Alt+1 { move-column-to-workspace 1; }
    Mod+Alt+2 { move-column-to-workspace 2; }
    Mod+Alt+3 { move-column-to-workspace 3; }
    Mod+Alt+4 { move-column-to-workspace 4; }
    Mod+Alt+5 { move-column-to-workspace 5; }
    Mod+Alt+6 { move-column-to-workspace 6; }
    Mod+Alt+7 { move-column-to-workspace 7; }
    Mod+Alt+8 { move-column-to-workspace 8; }
    Mod+Alt+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    //Mod+Comma  { consume-window-into-column; }
    //Mod+Period { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Alt+Shift+R { switch-preset-window-height; }
    Mod+Alt+R       { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+M { maximize-window-to-edges; }

    Mod+Alt+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    Mod+Alt+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+X       { toggle-window-floating; }
    Mod+Shift+X { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }
    
    Print       { screenshot-window; }
    Mod+Print   { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-region"; }


    Mod+V cooldown-ms=500 { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    Mod+BackSpace cooldown-ms=500 { spawn "noctalia" "msg" "panel-toggle" "session"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+Delete { spawn "uwsm" "stop"; }

    Mod+Shift+P { power-off-monitors; }
}

include "noctalia.kdl"
