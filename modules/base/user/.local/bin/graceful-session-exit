#!/bin/bash

# Получаем уникальные PID всех процессов (кроме самого Noctalia, иначе он убьет сам себя и прервет процесс перезагрузки)
PIDS=$(niri msg -j windows | jq -r 'map(select(.app_id != "dev.noctalia.Noctalia")) | .[].pid' | sort -u)

# Если окон нет, просто выходим
if [ -z "$PIDS" ]; then
    exit 0
fi

# Отправляем мягкий сигнал SIGTERM всем GUI процессам
for pid in $PIDS; do
    kill -15 $pid 2>/dev/null
done

# Ждем максимум 5 секунд до полного завершения
TIMEOUT=50
COUNT=0
while [ $COUNT -lt $TIMEOUT ]; do
    RUNNING=0
    for pid in $PIDS; do
        if kill -0 $pid 2>/dev/null; then
            RUNNING=1
            break
        fi
    done
    
    # Если никто больше не запущен, выходим из цикла
    if [ $RUNNING -eq 0 ]; then
        break
    fi
    
    sleep 0.1
    COUNT=$((COUNT + 1))
done

# Добиваем зависшие процессы (если такие остались)
for pid in $PIDS; do
    kill -9 $pid 2>/dev/null
done

exit 0
