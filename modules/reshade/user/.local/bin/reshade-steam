#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESHADE_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/reshade"
RESHADE_BIN_DIR="$RESHADE_DATA_DIR/reshade/latest"
RESHADE_SHADERS_DIR="$RESHADE_DATA_DIR/ReShade_shaders"
RESHADE_PRESETS_DIR="$RESHADE_DATA_DIR/presets"
RESHADE_INI_TEMPLATE="$RESHADE_DATA_DIR/ReShade.ini"

BUNDLED_PRESETS_DIR="$(cd "$SCRIPT_DIR/../share/reshade/presets" 2>/dev/null && pwd || true)"
BUNDLED_INI="$(cd "$SCRIPT_DIR/../share/reshade" 2>/dev/null && pwd || true)/ReShade.ini"

HOOK_DLLS=("dxgi" "d3d12" "d3d11" "d3d10" "d3d9" "opengl32")

mkdir -p "$RESHADE_DATA_DIR" "$RESHADE_BIN_DIR" "$RESHADE_SHADERS_DIR"

if [[ ! -d "$RESHADE_PRESETS_DIR" || -z "$(ls -A "$RESHADE_PRESETS_DIR" 2>/dev/null)" ]]; then
    if [[ -n "$BUNDLED_PRESETS_DIR" && -d "$BUNDLED_PRESETS_DIR" && "$BUNDLED_PRESETS_DIR" != "$RESHADE_PRESETS_DIR" ]]; then
        mkdir -p "$RESHADE_PRESETS_DIR"
        cp -rn "$BUNDLED_PRESETS_DIR"/* "$RESHADE_PRESETS_DIR"/ 2>/dev/null || true
    fi
fi

if [[ ! -f "$RESHADE_INI_TEMPLATE" && -f "$BUNDLED_INI" ]]; then
    cp -f "$BUNDLED_INI" "$RESHADE_INI_TEMPLATE"
fi

sync_git_repo() {
    local url="$1"
    local dest="$2"
    local branch="${3:-}"

    if [[ ! -d "$dest/.git" ]]; then
        printf ":: cloning %s -> %s\n" "$url" "$dest"
        mkdir -p "$(dirname "$dest")"
        if [[ -n "$branch" ]]; then
            git clone --depth 1 --branch "$branch" "$url" "$dest" || return 1
        else
            git clone --depth 1 "$url" "$dest" || return 1
        fi
    else
        printf ":: updating %s\n" "$dest"
        git -C "$dest" pull --ff-only 2>/dev/null || true
    fi
}

download_reshade() {
    if [[ ! -f "$RESHADE_BIN_DIR/ReShade64.dll" || ! -f "$RESHADE_BIN_DIR/ReShade32.dll" ]]; then
        printf ":: downloading latest reshade\n"
        local setup_url
        setup_url=$(curl -sL "https://reshade.me" 2>/dev/null | grep -oP '/downloads/ReShade_Setup_[0-9.]+\.exe' | head -n1 || true)
        if [[ -z "$setup_url" ]]; then
            setup_url="/downloads/ReShade_Setup_6.8.0.exe"
        fi
        local full_url="https://reshade.me${setup_url}"

        local tmp_dir
        tmp_dir=$(mktemp -d)
        if curl -sSL "$full_url" -o "$tmp_dir/reshade_setup.exe"; then
            7z e "$tmp_dir/reshade_setup.exe" -o"$RESHADE_BIN_DIR" ReShade64.dll ReShade32.dll ReShade64.json ReShade32.json -y >/dev/null
        fi
        rm -rf "$tmp_dir"
    else
        printf ":: reshade binaries already present\n"
    fi

    download_d3dcompiler_47
}

download_d3dcompiler_47() {
    local dest="$RESHADE_BIN_DIR/d3dcompiler_47.dll"
    if [[ -f "$dest" ]]; then
        return 0
    fi

    printf ":: downloading d3dcompiler_47.dll (64-bit)\n"
    local ff_url="https://download-installer.cdn.mozilla.net/pub/firefox/releases/62.0.3/win64/ach/Firefox%20Setup%2062.0.3.exe"
    local expected_hash="721977f36c008af2b637aedd3f1b529f3cfed6feb10f68ebe17469acb1934986"
    local tmp_dir
    tmp_dir=$(mktemp -d)
    if curl -fsSL "$ff_url" -o "$tmp_dir/ff_setup.exe"; then
        local actual_hash
        actual_hash=$(sha256sum "$tmp_dir/ff_setup.exe" | awk '{print $1}')
        if [[ "$actual_hash" == "$expected_hash" ]]; then
            7z e -y "$tmp_dir/ff_setup.exe" -o"$tmp_dir/out" d3dcompiler_47.dll >/dev/null 2>&1 || true
            local extracted
            extracted=$(find "$tmp_dir/out" -iname "d3dcompiler_47.dll" 2>/dev/null | head -n1 || true)
            if [[ -n "$extracted" && -f "$extracted" ]]; then
                install -Dm644 "$extracted" "$dest"
            fi
        else
            printf "warning: d3dcompiler_47 source hash mismatch\n" >&2
        fi
    fi
    rm -rf "$tmp_dir"
}

sync_shaders() {
    local repos=(
        "https://github.com/crosire/reshade-shaders.git|$RESHADE_SHADERS_DIR/reshade-shaders|slim"
        "https://github.com/crosire/reshade-shaders.git|$RESHADE_SHADERS_DIR/reshade-shaders-legacy|legacy"
        "https://github.com/CeeJayDK/SweetFX.git|$RESHADE_SHADERS_DIR/sweetfx-shaders|master"
        "https://github.com/martymcmodding/qUINT.git|$RESHADE_SHADERS_DIR/quint-shaders|master"
        "https://github.com/BlueSkyDefender/AstrayFX.git|$RESHADE_SHADERS_DIR/astrayfx-shaders|master"
        "https://github.com/prod80/prod80-ReShade-Repository.git|$RESHADE_SHADERS_DIR/prod80-shaders|master"
        "https://github.com/FransBouma/OtisFX.git|$RESHADE_SHADERS_DIR/otisfx-shaders|master"
        "https://github.com/luluco250/FXShaders.git|$RESHADE_SHADERS_DIR/fxshaders|master"
        "https://github.com/Fubaxiusz/fubax-shaders.git|$RESHADE_SHADERS_DIR/fubax-shaders|master"
    )

    for item in "${repos[@]}"; do
        IFS="|" read -r url dest branch <<< "$item"
        sync_git_repo "$url" "$dest" "$branch"
    done
}

merge_shaders() {
    printf ":: merging reshade shaders and textures\n"
    local merged_shaders="$RESHADE_SHADERS_DIR/Merged/Shaders"
    local merged_textures="$RESHADE_SHADERS_DIR/Merged/Textures"

    mkdir -p "$merged_shaders" "$merged_textures"

    find "$RESHADE_SHADERS_DIR" -maxdepth 4 -type f \( -name "*.fx" -o -name "*.fxh" \) ! -path "*/Merged/*" | while IFS= read -r file; do
        local fname
        fname=$(basename "$file")
        if [[ ! -e "$merged_shaders/$fname" ]]; then
            ln -sf "$file" "$merged_shaders/$fname"
        fi
    done

    find "$RESHADE_SHADERS_DIR" -maxdepth 4 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.dds" \) ! -path "*/Merged/*" | while IFS= read -r file; do
        local fname
        fname=$(basename "$file")
        if [[ ! -e "$merged_textures/$fname" ]]; then
            ln -sf "$file" "$merged_textures/$fname"
        fi
    done
}

get_steam_libraries() {
    local candidates=(
        "$HOME/.local/share/Steam"
        "$HOME/.steam/steam"
        "$HOME/.steam/root"
    )
    for vdf in "$HOME/.local/share/Steam/config/libraryfolders.vdf" \
               "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" \
               "$HOME/.steam/steam/config/libraryfolders.vdf"; do
        if [[ -f "$vdf" ]]; then
            while IFS= read -r p; do
                [[ -n "$p" ]] && candidates+=("$p")
            done < <(grep -oP '"path"\s+"\K[^"]+' "$vdf" 2>/dev/null || true)
        fi
    done

    printf "%s\n" "${candidates[@]}" | sort -u
}

find_dbd_binary_dir() {
    while IFS= read -r lib; do
        if [[ -d "$lib/steamapps/common/Dead by Daylight" ]]; then
            local bin_dir
            bin_dir=$(find "$lib/steamapps/common/Dead by Daylight" -name "DeadByDaylight-Win64-Shipping.exe" -printf "%h\n" 2>/dev/null | head -n1 || true)
            if [[ -n "$bin_dir" && -d "$bin_dir" ]]; then
                printf "%s\n" "$bin_dir"
                return 0
            fi
        fi
    done < <(get_steam_libraries)
    return 1
}

find_dbd_compatdata_dir() {
    while IFS= read -r lib; do
        if [[ -d "$lib/steamapps/compatdata/381210/pfx" ]]; then
            printf "%s\n" "$lib/steamapps/compatdata/381210/pfx"
            return 0
        fi
    done < <(get_steam_libraries)
    return 1
}

find_python_bin() {
    local candidate
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 && "$candidate" --version >/dev/null 2>&1; then
            printf "%s" "$candidate"
            return 0
        fi
    done
    return 1
}

apply_wine_override() {
    local pfx_dir="$1"
    local dll_name="${2:-dxgi}"
    local user_reg="$pfx_dir/user.reg"

    if [[ ! -f "$user_reg" ]]; then
        return 0
    fi

    local py_bin
    py_bin=$(find_python_bin || true)
    if [[ -z "$py_bin" ]]; then
        printf "warning: python not found, skipping user.reg update\n" >&2
        return 0
    fi

    "$py_bin" - "$user_reg" "$dll_name" << 'PYEOF'
import re
import sys
from pathlib import Path

reg_path = Path(sys.argv[1])
dll_name = sys.argv[2]
lines = reg_path.read_text(encoding="utf-8", errors="ignore").splitlines()

overrides = {dll_name: "native,builtin"}
if dll_name != "d3dcompiler_47":
    overrides["d3dcompiler_47"] = "native,builtin"

section_idx = None
section_end = len(lines)
for idx, line in enumerate(lines):
    if re.match(r"^\[Software\\+Wine\\+DllOverrides\]", line, re.IGNORECASE):
        section_idx = idx
        continue
    if section_idx is not None and line.startswith("["):
        section_end = idx
        break

if section_idx is None:
    if lines and lines[-1] != "":
        lines.append("")
    lines.append("[Software\\\\Wine\\\\DllOverrides]")
    for key, val in overrides.items():
        lines.append(f'"{key}"="{val}"')
else:
    insert_at = section_idx + 1
    while insert_at < section_end and lines[insert_at].startswith("#time="):
        insert_at += 1
    for key, val in overrides.items():
        pattern = re.compile(rf'^"{re.escape(key)}"\s*=')
        updated = False
        for j in range(insert_at, section_end):
            if pattern.match(lines[j]):
                lines[j] = f'"{key}"="{val}"'
                updated = True
                break
        if not updated:
            lines.insert(insert_at, f'"{key}"="{val}"')
            insert_at += 1
            section_end += 1

reg_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PYEOF
    printf ":: configured wine dll overrides (%s, d3dcompiler_47) in %s\n" "$dll_name" "$user_reg"
}

remove_wine_override() {
    local pfx_dir="$1"
    local dll_name="${2:-dxgi}"
    local user_reg="$pfx_dir/user.reg"

    if [[ ! -f "$user_reg" ]]; then
        return 0
    fi

    local py_bin
    py_bin=$(find_python_bin || true)
    if [[ -z "$py_bin" ]]; then
        return 0
    fi

    "$py_bin" - "$user_reg" "$dll_name" << 'PYEOF'
import re
import sys
from pathlib import Path

reg_path = Path(sys.argv[1])
dll_name = sys.argv[2]
lines = reg_path.read_text(encoding="utf-8", errors="ignore").splitlines()

in_section = False
out = []
targets = {dll_name, "d3dcompiler_47"}
for line in lines:
    if re.match(r"^\[Software\\+Wine\\+DllOverrides\]", line, re.IGNORECASE):
        in_section = True
        out.append(line)
        continue
    if in_section and line.startswith("["):
        in_section = False
    if in_section:
        m = re.match(r'^"([^"]+)"\s*=', line)
        if m and m.group(1) in targets:
            continue
    out.append(line)

reg_path.write_text("\n".join(out) + "\n", encoding="utf-8")
PYEOF
    printf ":: removed wine dll overrides (%s, d3dcompiler_47) from %s\n" "$dll_name" "$user_reg"
}

is_reshade_dll() {
    local file="$1"
    if [[ -L "$file" ]]; then
        local target_link
        target_link=$(readlink "$file" || true)
        [[ "$target_link" == *"ReShade"* ]] && return 0
    fi
    if [[ -f "$file" ]]; then
        local f_hash
        f_hash=$(sha256sum "$file" 2>/dev/null | awk '{print $1}')
        for ref in "$RESHADE_BIN_DIR/ReShade64.dll" "$RESHADE_BIN_DIR/ReShade32.dll"; do
            if [[ -f "$ref" ]]; then
                local ref_hash
                ref_hash=$(sha256sum "$ref" 2>/dev/null | awk '{print $1}')
                [[ -n "$f_hash" && "$f_hash" == "$ref_hash" ]] && return 0
            fi
        done
    fi
    return 1
}

cleanup_conflicting_dlls() {
    local target_dir="$1"
    local active_dll="$2"

    for hook in "${HOOK_DLLS[@]}"; do
        [[ "$hook" == "$active_dll" ]] && continue
        local candidate="$target_dir/$hook.dll"
        if [[ -e "$candidate" || -L "$candidate" ]] && is_reshade_dll "$candidate"; then
            printf ":: removing conflicting ReShade DLL %s.dll\n" "$hook"
            rm -f "$candidate"
        fi
    done
}

install_to_dir() {
    local target_dir="$1"
    local dll_name="${2:-dxgi}"

    if [[ ! -d "$target_dir" ]]; then
        printf "error: target directory '%s' does not exist\n" "$target_dir" >&2
        return 1
    fi
    if [[ ! -f "$RESHADE_BIN_DIR/ReShade64.dll" ]]; then
        download_reshade
    fi
    if [[ ! -f "$RESHADE_BIN_DIR/ReShade64.dll" ]]; then
        printf "error: ReShade64.dll missing in %s\n" "$RESHADE_BIN_DIR" >&2
        return 1
    fi

    printf ":: installing reshade into %s (dll: %s.dll)\n" "$target_dir" "$dll_name"

    cleanup_conflicting_dlls "$target_dir" "$dll_name"

    rm -f "$target_dir/$dll_name.dll"
    cp -f "$RESHADE_BIN_DIR/ReShade64.dll" "$target_dir/$dll_name.dll"

    if [[ -f "$RESHADE_BIN_DIR/d3dcompiler_47.dll" ]]; then
        rm -f "$target_dir/d3dcompiler_47.dll"
        cp -f "$RESHADE_BIN_DIR/d3dcompiler_47.dll" "$target_dir/d3dcompiler_47.dll"
    fi

    ln -sfn "$RESHADE_SHADERS_DIR" "$target_dir/ReShade_shaders"
    ln -sfn "$RESHADE_PRESETS_DIR" "$target_dir/reshade-presets"

    if [[ -f "$RESHADE_PRESETS_DIR/Normal.ini" ]]; then
        ln -sf "$RESHADE_PRESETS_DIR/Normal.ini" "$target_dir/Normal.ini"
    fi

    if [[ ! -f "$target_dir/ReShade.ini" && -f "$RESHADE_INI_TEMPLATE" ]]; then
        cp -f "$RESHADE_INI_TEMPLATE" "$target_dir/ReShade.ini"
    fi

    printf ":: reshade installed successfully\n"
    printf ":: steam launch options (recommended fallback):\n"
    printf "   WINEDLLOVERRIDES=\"d3dcompiler_47=n;%s=n,b\" %%command%%\n" "$dll_name"
}

uninstall_from_dir() {
    local target_dir="$1"
    if [[ ! -d "$target_dir" ]]; then
        printf "error: target directory '%s' does not exist\n" "$target_dir" >&2
        return 1
    fi

    printf ":: removing reshade from %s\n" "$target_dir"
    for hook in "${HOOK_DLLS[@]}"; do
        local candidate="$target_dir/$hook.dll"
        if [[ -e "$candidate" || -L "$candidate" ]] && is_reshade_dll "$candidate"; then
            rm -f "$candidate"
        fi
    done
    rm -f "$target_dir/d3dcompiler_47.dll"
    rm -f "$target_dir/ReShade_shaders" "$target_dir/reshade-presets"
    rm -f "$target_dir/ReShade.ini" "$target_dir/ReShade.log" "$target_dir/Normal.ini"
    printf ":: reshade removed successfully\n"
}

status_dir() {
    local target_dir="$1"
    local pfx_dir="${2:-}"

    printf ":: ReShade status for %s\n" "$target_dir"
    local active_hooks=()
    for hook in "${HOOK_DLLS[@]}"; do
        local candidate="$target_dir/$hook.dll"
        if [[ -e "$candidate" || -L "$candidate" ]] && is_reshade_dll "$candidate"; then
            active_hooks+=("$hook.dll")
        fi
    done
    if [[ ${#active_hooks[@]} -eq 0 ]]; then
        printf "  [-] hook DLL: none installed\n"
    elif [[ ${#active_hooks[@]} -gt 1 ]]; then
        printf "  [!] hook DLL collision detected: %s\n" "${active_hooks[*]}"
    else
        printf "  [+] hook DLL: %s\n" "${active_hooks[0]}"
    fi

    if [[ -f "$target_dir/d3dcompiler_47.dll" ]]; then
        printf "  [+] d3dcompiler_47.dll: present\n"
    else
        printf "  [!] d3dcompiler_47.dll: missing\n"
    fi

    if [[ -f "$target_dir/ReShade.ini" ]]; then
        printf "  [+] ReShade.ini: present\n"
    else
        printf "  [-] ReShade.ini: missing\n"
    fi

    if [[ -f "$target_dir/ReShade.log" ]]; then
        printf "  [+] ReShade.log: present (loaded on last run)\n"
    else
        printf "  [!] ReShade.log: missing (DLL has not loaded yet)\n"
    fi

    if [[ -n "$pfx_dir" && -f "$pfx_dir/user.reg" ]]; then
        if grep -q -E '^"dxgi"="native,builtin"' "$pfx_dir/user.reg"; then
            printf "  [+] Wine override (dxgi): configured in %s/user.reg\n" "$pfx_dir"
        else
            printf "  [!] Wine override (dxgi): missing in %s/user.reg\n" "$pfx_dir"
        fi
    fi
}

setup_all() {
    download_reshade
    sync_shaders
    merge_shaders

    local dbd_dir
    dbd_dir=$(find_dbd_binary_dir || true)
    if [[ -n "$dbd_dir" ]]; then
        printf ":: detected Dead by Daylight at %s\n" "$dbd_dir"
        install_to_dir "$dbd_dir" "dxgi"
        local dbd_pfx
        dbd_pfx=$(find_dbd_compatdata_dir || true)
        if [[ -n "$dbd_pfx" ]]; then
            apply_wine_override "$dbd_pfx" "dxgi"
        fi
    fi
}

main() {
    case "${1:-}" in
        --setup|setup)
            setup_all
            ;;
        --dbd|dbd)
            local dbd_dir
            dbd_dir=$(find_dbd_binary_dir || true)
            if [[ -n "$dbd_dir" ]]; then
                install_to_dir "$dbd_dir" "${2:-dxgi}"
                local dbd_pfx
                dbd_pfx=$(find_dbd_compatdata_dir || true)
                if [[ -n "$dbd_pfx" ]]; then
                    apply_wine_override "$dbd_pfx" "${2:-dxgi}"
                fi
            else
                printf "error: Dead by Daylight executable not found\n" >&2
                exit 1
            fi
            ;;
        install)
            if [[ -z "${2:-}" || "${2:-}" == "dbd" ]]; then
                local dbd_dir
                dbd_dir=$(find_dbd_binary_dir || true)
                if [[ -n "$dbd_dir" ]]; then
                    install_to_dir "$dbd_dir" "${3:-dxgi}"
                    local dbd_pfx
                    dbd_pfx=$(find_dbd_compatdata_dir || true)
                    if [[ -n "$dbd_pfx" ]]; then
                        apply_wine_override "$dbd_pfx" "${3:-dxgi}"
                    fi
                else
                    printf "error: Dead by Daylight not found. Supply path: reshade-steam install <game_dir>\n" >&2
                    exit 1
                fi
            else
                install_to_dir "$2" "${3:-dxgi}"
            fi
            ;;
        uninstall)
            if [[ -z "${2:-}" || "${2:-}" == "dbd" ]]; then
                local dbd_dir
                dbd_dir=$(find_dbd_binary_dir || true)
                if [[ -n "$dbd_dir" ]]; then
                    uninstall_from_dir "$dbd_dir"
                    local dbd_pfx
                    dbd_pfx=$(find_dbd_compatdata_dir || true)
                    if [[ -n "$dbd_pfx" ]]; then
                        remove_wine_override "$dbd_pfx" "dxgi"
                    fi
                fi
            else
                uninstall_from_dir "$2"
            fi
            ;;
        status)
            if [[ -z "${2:-}" || "${2:-}" == "dbd" ]]; then
                local dbd_dir
                dbd_dir=$(find_dbd_binary_dir || true)
                if [[ -n "$dbd_dir" ]]; then
                    local dbd_pfx
                    dbd_pfx=$(find_dbd_compatdata_dir || true)
                    status_dir "$dbd_dir" "$dbd_pfx"
                else
                    printf "error: Dead by Daylight not found. Supply path: reshade-steam status <game_dir>\n" >&2
                    exit 1
                fi
            else
                status_dir "$2"
            fi
            ;;
        update|update-shaders)
            download_reshade
            sync_shaders
            merge_shaders
            ;;
        list-presets)
            printf ":: available momo reshades presets:\n"
            find "$RESHADE_PRESETS_DIR" -name "*.ini" -printf "   %f\n" 2>/dev/null | sort
            ;;
        *)
            printf "usage: reshade-steam [--setup | --dbd | install [path] | uninstall [path] | status [path] | update | list-presets]\n"
            ;;
    esac
}

main "$@"
