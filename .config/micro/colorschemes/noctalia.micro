color-link default "#cdd6f4,#1e1e2e"
color-link comment "#646789"

color-link identifier "#cba6f7"
color-link identifier.class "#cba6f7"
color-link identifier.var "#cba6f7"

color-link constant "#94e2d5"
color-link constant.number "#94e2d5"
color-link constant.string "#fab387"

color-link symbol "#cba6f7"
color-link symbol.brackets "#cdd6f4"
color-link symbol.tag "#cba6f7"

color-link type "#cba6f7"
color-link type.keyword "#94e2d5"

color-link special "#cba6f7"
color-link statement "#fab387"
color-link preproc "#cba6f7"

color-link underlined "#cba6f7"
color-link error "bold #f38ba8"
color-link todo "bold #94e2d5"

color-link diff-added "#fab387"
color-link diff-modified "#94e2d5"
color-link diff-deleted "#f38ba8"

color-link gutter-error "#f38ba8"
color-link gutter-warning "#94e2d5"

color-link statusline "#cdd6f4,#313244"
color-link tabbar "#cdd6f4,#313244"
color-link indent-char "#313244"
color-link line-number "#646789"
color-link current-line-number "#cba6f7"

color-link cursor-line "underlined"
color-link selection ",#313244"
color-link color-column "#313244"
color-link type.extended "default"
