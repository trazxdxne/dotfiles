autostart {
    workspace "1" {
        column {
            width {
                proportion 0.67
            }
            window app-id="brave-pommaclcbfghclhalboakcipcmmndhcj-Default" {
                command "/opt/brave-origin-bin/brave-origin" "--profile-directory=Default" "--app-id=pommaclcbfghclhalboakcipcmmndhcj"
                height { proportion 1.0; }
            }
            window app-id="com.ayugram.desktop" {
                command "AyuGram" "-autostart"
                height { proportion 1.0; }
            }
            window app-id="discord" {
                command "discord"
                height { proportion 1.0; }
            }
        }
        
        column {
            width {
                proportion 1.0
            }
            window app-id="brave-origin" {
                command "/opt/brave-origin-bin/brave-origin" "--new-window"
                height { proportion 1.0; }
            }
        }
    }

    workspace "1 " {
        column {
            width {
                proportion 1.0
            }
            window app-id="brave-chddojmiiokipokdfcabeikjhljgcafd-Default" {
                command "/opt/brave-origin-bin/brave-origin" "--profile-directory=Default" "--app-id=chddojmiiokipokdfcabeikjhljgcafd"
                height { proportion 1.0; }
            }
            window app-id="brave-agimnkijcaahngcdmfeangaknmldooml-Default" {
                command "/opt/brave-origin-bin/brave-origin" "--profile-directory=Default" "--app-id=agimnkijcaahngcdmfeangaknmldooml"
                height { proportion 1.0; }
            }
        }
    }
}
