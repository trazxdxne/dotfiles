[Unit]
Description=Zapret DPI Bypass Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/zapret.pid
ExecStart=/usr/local/bin/zapret-runner.sh start
ExecStop=/usr/local/bin/zapret-runner.sh stop
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
